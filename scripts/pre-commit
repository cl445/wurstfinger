#!/bin/bash
# Pre-commit hook: runs SwiftFormat and SwiftLint on staged Swift files,
# and markdownlint on staged Markdown files

# Get staged files (added, copied, modified, renamed)
STAGED_SWIFT=$(git diff --cached --name-only --diff-filter=ACMR -- '*.swift')
STAGED_MARKDOWN=$(git diff --cached --name-only --diff-filter=ACMR -- '*.md')
STAGED_GLOSSARY=$(git diff --cached --name-only --diff-filter=ACMR -- glossary.toml .naming-budget.json)
# Separate from the sources above: a hand-edit to a generated section of
# GLOSSARY.md has to reach `render --check` even when nothing else is staged.
STAGED_GLOSSARY_DOC=$(git diff --cached --name-only --diff-filter=ACMR -- docs/GLOSSARY.md)

if [ -z "$STAGED_SWIFT" ] && [ -z "$STAGED_MARKDOWN" ] && [ -z "$STAGED_GLOSSARY" ]; then
    exit 0
fi

FAILED=0

if [ -n "$STAGED_SWIFT" ]; then
    # SwiftFormat: auto-format staged files and re-stage them
    if command -v swiftformat &> /dev/null; then
        echo "Running SwiftFormat on staged files..."
        while IFS= read -r file; do
            if [ -f "$file" ]; then
                if swiftformat "$file"; then
                    git add "$file"
                else
                    echo "error: SwiftFormat failed for $file"
                    FAILED=1
                fi
            fi
        done <<< "$STAGED_SWIFT"
    else
        echo "error: SwiftFormat not installed (brew install swiftformat)"
        FAILED=1
    fi

    # SwiftLint: check staged files for violations
    if command -v swiftlint &> /dev/null; then
        echo "Running SwiftLint on staged files..."
        while IFS= read -r file; do
            if [ -f "$file" ]; then
                # Warn about partially staged files (working tree differs from index)
                if ! git diff --quiet -- "$file"; then
                    echo "warning: $file has unstaged changes — linting working tree version"
                fi
                swiftlint lint --strict --quiet "$file"
                if [ $? -ne 0 ]; then
                    FAILED=1
                fi
            fi
        done <<< "$STAGED_SWIFT"
    else
        echo "error: SwiftLint not installed (brew install swiftlint)"
        FAILED=1
    fi
fi

if [ -n "$STAGED_MARKDOWN" ]; then
    # markdownlint: auto-fix and re-stage fully staged files, check the rest.
    # Rules and ignores come from .markdownlint-cli2.jsonc in the repo root.
    if command -v markdownlint-cli2 &> /dev/null; then
        echo "Running markdownlint on staged files..."

        # Splitting matters: --fix rewrites the working tree, so re-staging a
        # partially staged file would sweep in unrelated unstaged edits.
        FIXABLE=()
        CHECK_ONLY=()
        while IFS= read -r file; do
            if [ -f "$file" ]; then
                if git diff --quiet -- "$file"; then
                    FIXABLE+=("$file")
                else
                    echo "warning: $file has unstaged changes — checking without --fix"
                    CHECK_ONLY+=("$file")
                fi
            fi
        done <<< "$STAGED_MARKDOWN"

        if [ ${#FIXABLE[@]} -gt 0 ]; then
            if markdownlint-cli2 --fix "${FIXABLE[@]}"; then
                git add "${FIXABLE[@]}"
            else
                # Re-stage whatever --fix managed to repair so the remaining
                # violations are the only thing left to deal with.
                git add "${FIXABLE[@]}"
                FAILED=1
            fi
        fi

        if [ ${#CHECK_ONLY[@]} -gt 0 ]; then
            if ! markdownlint-cli2 "${CHECK_ONLY[@]}"; then
                FAILED=1
            fi
        fi
    else
        echo "error: markdownlint-cli2 not installed (brew install markdownlint-cli2)"
        FAILED=1
    fi
fi

# Naming: identifiers are checked against glossary.toml, with the backlog frozen
# per file in .naming-budget.json. The check reads the whole tree rather than the
# staged files, because a budget is only meaningful as a total — it takes about
# half a second.
if [ -n "$STAGED_SWIFT" ] || [ -n "$STAGED_GLOSSARY" ]; then
    echo "Checking naming against the glossary..."
    if ! python3 scripts/check_naming.py check; then
        FAILED=1
    fi
fi

# The generated sections are checked whenever their sources *or* the document
# itself is staged. Editing only GLOSSARY.md is exactly how a generated table
# goes stale, so that case must not fall through.
if [ -n "$STAGED_GLOSSARY" ] || [ -n "$STAGED_GLOSSARY_DOC" ]; then
    if ! python3 scripts/check_naming.py render --check; then
        FAILED=1
    fi
fi

if [ $FAILED -ne 0 ]; then
    echo ""
    echo "Pre-commit checks failed. Fix the issues above, or use --no-verify to skip."
    exit 1
fi
