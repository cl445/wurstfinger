// markdownlint configuration — see https://github.com/DavidAnson/markdownlint/blob/main/doc/Rules.md
//
// Deliberately no "globs" key: markdownlint-cli2 *appends* configured globs to
// the ones passed on the command line, which would make the pre-commit hook
// lint the whole repository instead of just the staged files. Callers pass the
// files to lint (CI uses "**/*.md").
{
    "config": {
        "default": true,

        // Prose is written one sentence per line and CHANGELOG entries run long.
        // Hard-wrapping them would churn diffs without making anything readable.
        "MD013": false,

        // Every heading in this repository is ATX ("## Heading").
        "MD003": { "style": "atx" },

        // The Keep a Changelog format repeats "Added"/"Fixed"/"Changed" once per
        // release, so only flag duplicates within the same section.
        "MD024": { "siblings_only": true },

        // The README arranges screenshots in an HTML table — Markdown has no
        // equivalent for a two-column image grid.
        "MD033": {
            "allowed_elements": ["table", "tr", "td", "th", "img", "p", "i", "br"]
        },

        // Emphasised metadata lines ("*Last updated: …*") are not headings.
        "MD036": false
    },

    // Skip anything .gitignore already excludes, so a git worktree checked out
    // inside the repository does not turn a local run into a wall of noise.
    "gitignore": true,

    "ignores": [
        // Generated by `bundle exec fastlane docs`; its layout is not ours to fix.
        "fastlane/README.md",
        "**/node_modules/**"
    ]
}
